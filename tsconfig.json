{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "rootDir": ".",
    "esModuleInterop": true,
    "outDir": "./dist",
    "moduleResolution": "node",
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "declaration": true,
    "removeComments": false,
    "target": "es2017",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "paths": {
      "geofirestore": [
        "./dist/packages/geofirestore/index.d.ts"
      ],
      "geofirestore-core": [
        "./dist/packages/geofirestore-core/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "packages/geofirestore/src/**/*",
    "packages/geofirestore/test/**/*",
    "packages/geofirestore-core/src/**/*",
    "packages/geofirestore-core/test/**/*"
  ]
}