{
  "name": "geofirestore-core",
  "description": "Lightweight location-based querying and encoding of Firebase Firestore Documents for geofirestore.",
  "version": "5.0.0",
  "scripts": {
    "build": "nx build geofirestore-core",
    "clean": "nx clean geofirestore-core",
    "coverage": "nx coverage geofirestore-core",
    "docs": "nx docs geofirestore-core",
    "lint": "nx lint geofirestore-core",
    "test": "nx test geofirestore-core"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.esm.js",
      "require": "./index.cjs.js"
    }
  },
  "author": "Michael Solati <mkslt04@gmail.com>",
  "homepage": "https://core.geofirestore.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelSolati/geofirestore-js.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelSolati/geofirestore-js/issues"
  },
  "readme": "README.md",
  "license": "MIT",
  "keywords": [
    "geoquery",
    "location",
    "firebase",
    "firestore",
    "realtime",
    "geolocation",
    "geofire",
    "geohash",
    "map"
  ],
  "dependencies": {
    "geokit": "^1.1.0"
  },
  "optionalDependencies": {
    "@google-cloud/firestore": ">= 5.0.0 < 6.0.0",
    "firebase": ">= 9.0.0 < 10.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.5",
    "chai": "^5.2.0",
    "coveralls": "^3.1.1",
    "firebase-tools": "^14.9.0",
    "generate-changelog": "^1.8.0",
    "gts": "^6.0.2",
    "jsdom": "^26.1.0",
    "jsdom-global": "^3.0.2",
    "mocha": "^11.7.1",
    "nx": "^21.2.1",
    "nyc": "^17.1.0",
    "protobufjs": "^7.5.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.6",
    "typescript": "^5.6.3"
  },
  "mocha": {
    "extension": [
      "ts"
    ],
    "reporter": "spec",
    "require": [
      "ts-node/register",
      "jsdom-global/register"
    ],
    "timeout": 30000
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "html"
    ],
    "all": true
  }
}