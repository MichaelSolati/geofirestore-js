{
  "name": "geofirestore-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/geofirestore-core/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/geofirestore-core",
        "configFile": "packages/geofirestore-core/vite.config.ts",
        "tsConfig": "packages/geofirestore-core/tsconfig.json"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf ./dist ./coverage ./docs ./.nyc_output",
        "cwd": "packages/geofirestore-core"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nyc report --reporter=text-lcov | coveralls",
        "cwd": "packages/geofirestore-core"
      }
    },
    "docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typedoc",
        "cwd": "packages/geofirestore-core"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/geofirestore-core/src/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase emulators:exec --only firestore 'nyc --reporter=html --reporter=text mocha --package package.json --exit'",
        "cwd": "packages/geofirestore-core"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}